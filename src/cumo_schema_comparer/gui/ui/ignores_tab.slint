// Ignore rules: the user's own rules are editable, the bundled defaults are shown read-only.

import { LineEdit, ComboBox, Button, ScrollView, GroupBox } from "std-widgets.slint";
import { LabelledCheck } from "widgets.slint";
import { Tokens } from "tokens.slint";

// kinds, names, attributes, targets and statuses are comma-separated; the view model splits them.
export struct RuleRow {
    id: string,
    reason: string,
    kinds: string,
    names: string,
    attributes: string,
    targets: string,
    statuses: string,
    action: string,
    read_only: bool,
}

export component RuleLine inherits Rectangle {
    in property <RuleRow> data;
    callback changed(string, string);   // field, value
    callback remove();

    // How many of this row's controls accept input: 9 for an editable rule, 0 for a bundled
    // default. Reads the controls themselves, so a dropped read-only binding shows here.
    out property <int> editable-count:
        (id-edit.read-only ? 0 : 1) + (reason-edit.read-only ? 0 : 1)
        + (kinds-edit.read-only ? 0 : 1) + (names-edit.read-only ? 0 : 1)
        + (attributes-edit.read-only ? 0 : 1) + (targets-edit.read-only ? 0 : 1)
        + (statuses-edit.read-only ? 0 : 1) + (action-box.enabled ? 1 : 0)
        + (remove-button.enabled ? 1 : 0);
    // What the action ComboBox actually offers.
    out property <[string]> action-choices: action-box.model;

    VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-1;
        HorizontalLayout {
            spacing: Tokens.space-2;
            id-edit := LineEdit {
                text: root.data.id;
                placeholder-text: "id";
                read-only: root.data.read_only;
                edited(v) => { root.changed("id", v); }
            }
            reason-edit := LineEdit {
                text: root.data.reason;
                placeholder-text: "reason";
                read-only: root.data.read_only;
                edited(v) => { root.changed("reason", v); }
            }
            action-box := ComboBox {
                model: ["ignore", "warn", "info"];
                current-value: root.data.action;
                enabled: !root.data.read_only;
                selected(v) => { root.changed("action", v); }
            }
            remove-button := Button {
                text: "Remove";
                enabled: !root.data.read_only;
                clicked => { root.remove(); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-2;
            kinds-edit := LineEdit {
                text: root.data.kinds;
                placeholder-text: "kinds, comma separated";
                read-only: root.data.read_only;
                edited(v) => { root.changed("kinds", v); }
            }
            names-edit := LineEdit {
                text: root.data.names;
                placeholder-text: "names (globs), comma separated";
                read-only: root.data.read_only;
                edited(v) => { root.changed("names", v); }
            }
            attributes-edit := LineEdit {
                text: root.data.attributes;
                placeholder-text: "attributes, comma separated";
                read-only: root.data.read_only;
                edited(v) => { root.changed("attributes", v); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-2;
            targets-edit := LineEdit {
                text: root.data.targets;
                placeholder-text: "targets, comma separated";
                read-only: root.data.read_only;
                edited(v) => { root.changed("targets", v); }
            }
            statuses-edit := LineEdit {
                text: root.data.statuses;
                placeholder-text: "statuses, comma separated";
                read-only: root.data.read_only;
                edited(v) => { root.changed("statuses", v); }
            }
        }
    }
}

export component IgnoresTab inherits ScrollView {
    in property <[RuleRow]> rules;
    in property <[RuleRow]> default-rules;
    in-out property <bool> case-insensitive-globs;

    callback rule-changed(string, string, string);   // rule id, field, value
    callback add-rule();
    callback remove-rule(string);
    callback save-ignores();

    // Rows actually handed to this tab; lets a test see that the window wired the models in.
    out property <int> rule-count: root.rules.length;
    out property <int> default-rule-count: root.default-rules.length;

    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-3;

        GroupBox {
            title: "Ignore rules";
            VerticalLayout {
                spacing: Tokens.space-2;
                for row[i] in root.rules: RuleLine {
                    background: mod(i, 2) == 0 ? transparent : Tokens.stripe;
                    data: row;
                    changed(f, v) => { root.rule-changed(row.id, f, v); }
                    remove => { root.remove-rule(row.id); }
                }
                LabelledCheck {
                    label: "case_insensitive_globs";
                    value <=> root.case-insensitive-globs;
                    toggled(v) => {
                        root.rule-changed("", "case_insensitive_globs", v ? "true" : "false");
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Button { text: "Add rule"; clicked => { root.add-rule(); } }
                    Button { text: "Save"; primary: true; clicked => { root.save-ignores(); } }
                }
            }
        }

        GroupBox {
            title: "bundled defaults";
            VerticalLayout {
                spacing: Tokens.space-2;
                for row[i] in root.default-rules: RuleLine {
                    background: mod(i, 2) == 0 ? transparent : Tokens.stripe;
                    data: row;
                }
            }
        }
    }
}
