// The window shell. Tabs are added by later tasks; the properties and callbacks the Python layer
// binds are declared here and forwarded down.

import { Button } from "std-widgets.slint";
import { Toast, NavItem, RailLabel } from "widgets.slint";
import { Tokens } from "tokens.slint";
import { ConfigTab, SourceRow } from "config_tab.slint";
import { IgnoresTab, RuleRow } from "ignores_tab.slint";
import { AboutTab } from "about_tab.slint";
import { TunnelDialog, TunnelStep } from "tunnel_dialog.slint";
import { RunDialog, RunInput, RunStep } from "run_dialog.slint";
import { RunTab, ProgressRow } from "run_tab.slint";
import { ResultsTab, FindingRow, DeltaRow, DiffLine } from "results_tab.slint";

export { SourceRow, RuleRow, ProgressRow, FindingRow, DeltaRow, DiffLine }
export { TunnelStep }

export component MainWindow inherits Window {
    title: "cumo-schema-diff";
    preferred-width: 1320px;
    preferred-height: 820px;
    background: Tokens.page;
    // Set once, inherited by every widget: std-widgets expose font-size but not font-family,
    // so a LineEdit can only be reached through the window's default.
    default-font-family: Tokens.family-body;
    default-font-size: Tokens.text-body;
    default-font-weight: Tokens.weight-regular;

    // Which view the rail has selected. All five are instantiated; one is visible.
    // The width the views get: the window less the rail and the gutters, capped. Derived from the
    // window rather than from the content column itself, which would be self-referential and
    // evaluates to zero. In-out so a test can drive the Results breakpoint: setting a Window's own
    // `width` before it is shown is not honoured — it reports its minimum — so the breakpoint
    // would otherwise be untestable.
    in-out property <length> column-width: min(
        root.width - Tokens.rail-width - 2 * Tokens.space-5, Tokens.container-max);
    in-out property <int> current-view: 0;
    in-out property <string> config-path;
    in-out property <bool> dirty;
    in-out property <string> status-message;
    in-out property <bool> status-is-error;
    // Bumped by the application for every message. The same text twice — two failed checks of
    // one source — is two events, and without this the second would show nothing.
    in-out property <int> status-token;
    in property <[SourceRow]> sources;
    in property <[string]> exclude-schemas;
    // The editable comma-separated form of exclude-schemas.
    in-out property <string> exclude-schemas-text: "";

    in-out property <int> connect-timeout-seconds: 10;
    in-out property <int> statement-timeout-seconds: 60;
    in-out property <int> lock-timeout-seconds: 3;
    in-out property <bool> parallel: true;
    in-out property <int> max-workers: 4;
    in-out property <string> fail-on: "error";
    in-out property <bool> ignore-column-order;
    in-out property <bool> include-owners;
    in-out property <bool> include-comments;
    in-out property <bool> include-grants;

    in property <[RuleRow]> rules;
    in property <[RuleRow]> default-rules;
    in-out property <bool> case-insensitive-globs;

    in property <bool> keychain-available;
    in property <string> keychain-problem;

    // What the About view shows. Supplied by the application: a version written into markup
    // is a version that will be wrong.
    in property <string> about-version;
    in property <string> about-python;
    in property <string> about-slint;
    in property <string> about-config-path;
    in property <bool> about-tunnelling;

    // The gateway test's own dialog. Modal, because the answer is the only thing worth
    // attending to while it is up and a second test underneath would report over the first.
    in-out property <bool> tunnel-open;
    in-out property <bool> tunnel-busy;
    in-out property <bool> tunnel-ok;
    in-out property <string> tunnel-gateway;
    in-out property <string> tunnel-summary;
    in property <[TunnelStep]> tunnel-steps;
    callback close-tunnel-dialog();

    // The comparison's own dialog. Says what is being compared before it starts and fills in a
    // checklist as it runs, so a clean report can be told from a report of the wrong thing.
    in-out property <bool> run-open;
    in-out property <bool> run-busy;
    in-out property <string> run-title;
    in-out property <string> run-summary;
    in-out property <string> run-summary-level: "ok";
    in property <[RunInput]> run-inputs;
    in property <[RunStep]> run-steps;
    callback close-run-dialog();
    callback show-run-results();

    // Run. Defaults are the CLI's defaults.
    in-out property <bool> running: false;
    in property <[ProgressRow]> progress;
    in-out property <string> run-fail-on: "error";
    in-out property <string> baseline-path: "";
    in-out property <bool> show-cosmetic: false;
    in-out property <bool> skip-liquibase: false;
    in-out property <bool> strict-changelog: false;
    in-out property <bool> no-default-ignores: false;
    in-out property <bool> allow-unreachable: false;
    in-out property <bool> sequential: false;

    // Results. verdict-level is the run-level outcome, never derived from progress.
    in-out property <string> verdict: "";
    in-out property <string> verdict-level: "";
    in property <[FindingRow]> findings;
    in property <int> total-findings;
    in property <string> selected-heading;
    in property <[DeltaRow]> selected-deltas;
    in property <[DiffLine]> selected-diff;
    callback select-finding(string, string, string);
    in-out property <string> filter-text: "";
    in-out property <bool> show-error: true;
    in-out property <bool> show-warning: true;
    in-out property <bool> show-info: true;
    in-out property <string> output-directory: "";

    callback start-run();
    callback cancel-run();
    callback choose-baseline();
    callback choose-output-directory();
    callback write-reports();
    callback open-html();
    callback filter-changed();

    callback rule-changed(string, string, string);
    callback add-rule();
    callback remove-rule(string);
    callback save-ignores();

    callback source-changed(string, string, string);
    callback config-changed(string, string);
    callback add-target();
    callback remove-target(string);
    callback check-connection(string);
    callback store-password(string, string);
    callback forget-password(string);
    callback test-tunnel(string);
    callback choose-ssh-key(string);
    callback select-source-tab(string, int);
    callback check-all();
    callback validate-config();
    callback save-config();

    // Read-backs and a driver for tests. Python cannot click, and a callback it assigns replaces
    // the handler it would be testing, so these run the real forwarding chain instead.
    public function ignores-rule-count() -> int { return ignores-tab.rule-count; }
    public function ignores-default-rule-count() -> int { return ignores-tab.default-rule-count; }

    public function run-progress-count() -> int { return run-tab.progress-count; }
    public function results-finding-count() -> int { return results-tab.finding-count; }
    public function results-delta-count() -> int { return results-tab.delta-count; }
    public function results-diff-count() -> int { return results-tab.diff-count; }
    pure public function results-diff-colour-for(kind: string) -> color {
        return results-tab.diff-colour-for(kind);
    }
    public function results-diff-viewport-width() -> length { return results-tab.diff-viewport-width; }
    public function results-side-by-side() -> bool { return results-tab.side-by-side; }
    // Where the views begin. Nothing but the status line — which is zero-height when there is
    // no message — may sit above them: a strip across the top costs every view its height.
    public function content-top() -> length { return content.y; }
    public function toast-showing() -> bool { return toast.showing; }
    public function toast-text() -> string { return toast.shown; }
    public function drive-dismiss-toast() { toast.dismiss(); }
    public function results-findings-box() -> [length] { return results-tab.findings-box; }
    public function results-detail-box() -> [length] { return results-tab.detail-box; }
    public function results-diff-pane-width() -> length { return results-tab.diff-pane-width; }
    public function results-diff-pane-height() -> length { return results-tab.diff-pane-height; }
    public function results-tab-min-width() -> length { return results-tab.tab-min-width; }
    pure public function results-starts-group(index: int) -> bool {
        return results-tab.starts-group(index);
    }
    public function results-heading-shown() -> string { return results-tab.heading-shown; }
    public function drive-select-row(index: int) { results-tab.choose-row(index); }
    public function drive-select-view(index: int) { root.current-view = index; }
    public function drive-test-tunnel(label: string) { root.test-tunnel(label); }
    public function drive-store-password(label: string, secret: string) {
        config-tab.submit(label, secret);
    }
    public function drive-forget-password(label: string) { config-tab.drop(label); }
    public function drive-close-tunnel-dialog() { root.close-tunnel-dialog(); }
    public function tunnel-dialog-open() -> bool { return dialog.visible; }
    public function run-dialog-open() -> bool { return run-dialog.visible; }
    public function run-input-count() -> int { return run-dialog.input-count; }
    public function run-step-count() -> int { return run-dialog.step-count; }
    public function drive-close-run-dialog() { root.close-run-dialog(); }
    public function drive-show-run-results() { root.show-run-results(); }
    public function drive-cancel-from-run-dialog() { root.cancel-run(); }
    public function tunnel-step-count() -> int { return root.tunnel-steps.length; }
    public function drive-choose-ssh-key(label: string) { root.choose-ssh-key(label); }
    public function drive-select-source-tab(label: string, index: int) {
        root.select-source-tab(label, index);
    }
    pure public function view-visible(index: int) -> bool {
        return index == 0 ? config-tab.visible
            : index == 1 ? run-tab.visible
            : index == 2 ? results-tab.visible
            : index == 3 ? ignores-tab.visible
            : index == 4 ? about-tab.visible
            : false;
    }
    out property <int> view-count: 5;
    public function run-start-enabled() -> bool { return run-tab.start-enabled; }
    public function run-cancel-enabled() -> bool { return run-tab.cancel-enabled; }
    public function results-banner-kind() -> string { return results-tab.banner-kind; }
    public function results-banner-is-success() -> bool { return results-tab.banner-is-success; }
    public function run-fail-on-choices() -> string {
        return run-tab.fail-on-choices[0] + "," + run-tab.fail-on-choices[1] + ","
            + run-tab.fail-on-choices[2] + "," + run-tab.fail-on-choices[3];
    }
    public function run-banner-background() -> color { return results-tab.banner-background; }
    public function run-banner-text-color() -> color { return results-tab.banner-text-color; }
    public function results-summary() -> string { return results-tab.findings-summary; }
    public function results-filter-hides-rows() -> bool { return results-tab.filter-hides-rows; }
    public function results-reports-enabled() -> bool { return results-tab.reports-enabled; }
    public function results-baseline-shown() -> string { return run-tab.baseline-shown; }
    public function results-output-directory-shown() -> string { return results-tab.output-directory-shown; }
    public function results-filter-shown() -> string { return results-tab.filter-shown; }
    public function results-show-error-shown() -> bool { return results-tab.error-shown; }
    public function results-show-warning-shown() -> bool { return results-tab.warning-shown; }
    public function results-show-info-shown() -> bool { return results-tab.info-shown; }
    public function drive-type-baseline(v: string) { run-tab.type-baseline(v); }
    public function drive-type-filter(v: string) { results-tab.type-filter(v); }
    public function drive-type-output-directory(v: string) { results-tab.type-output-directory(v); }
    public function drive-toggle-error(v: bool) { results-tab.toggle-error(v); }
    public function drive-toggle-warning(v: bool) { results-tab.toggle-warning(v); }
    public function drive-toggle-info(v: bool) { results-tab.toggle-info(v); }
    public function drive-start-run() { run-tab.request-start(); }
    public function drive-cancel-run() { run-tab.request-cancel(); }
    public function drive-choose-baseline() { run-tab.request-choose-baseline(); }
    public function drive-filter-changed() { results-tab.request-filter-changed(); }
    public function drive-choose-output-directory() { results-tab.request-choose-output-directory(); }
    public function drive-write-reports() { results-tab.request-write-reports(); }
    public function drive-open-html() { results-tab.request-open-html(); }

    HorizontalLayout {
        // The navigation rail: a navy surface carrying the wordmark and the five views. The
        // selected one is marked in lime rather than by fill alone.
        Rectangle {
            width: Tokens.rail-width;
            background: Tokens.navy-rail;
            VerticalLayout {
                padding-top: Tokens.space-5;
                padding-bottom: Tokens.space-4;
                spacing: Tokens.space-1;

                // The Cubic lockup, mark and wordmark, already white on a transparent ground: it was
                // cut from the brand's navy slide background, so it needs no recolouring here. A
                // layout supplies the gutter because an `x` on a layout child is ignored; the
                // height follows the picture's 410:80.
                HorizontalLayout {
                    padding-left: Tokens.space-4;
                    padding-right: Tokens.space-4;
                    alignment: start;
                    Image {
                        source: @image-url("cubic-lockup.png");
                        image-fit: contain;
                        width: Tokens.rail-width - 2 * Tokens.space-4;
                        height: self.width * 80 / 410;
                    }
                }
                RailLabel { x: Tokens.space-4; text: "SCHEMA DIFF"; }
                Rectangle { height: Tokens.space-5; }

                NavItem {
                    label: "Config";
                    selected: root.current-view == 0;
                    clicked => { root.current-view = 0; }
                }
                NavItem {
                    label: "Run";
                    selected: root.current-view == 1;
                    clicked => { root.current-view = 1; }
                }
                NavItem {
                    label: "Results";
                    selected: root.current-view == 2;
                    clicked => { root.current-view = 2; }
                }
                NavItem {
                    label: "Ignores";
                    selected: root.current-view == 3;
                    clicked => { root.current-view = 3; }
                }
                NavItem {
                    label: "About";
                    selected: root.current-view == 4;
                    clicked => { root.current-view = 4; }
                }

                // Takes the slack, so the config block below sits at the foot of the rail.
                Rectangle { }

                Rectangle { height: Tokens.hairline-width; background: Tokens.navy-selected; }
                // No path and no label: the application writes to one place and does not open
                // files, so a path in the navigation told nobody anything they could act on. What
                // is still worth saying is whether there is anything unsaved.
                VerticalLayout {
                    padding-left: Tokens.space-4;
                    padding-right: Tokens.space-4;
                    padding-top: Tokens.space-3;
                    Text {
                        text: root.dirty ? "• unsaved changes" : "";
                        font-size: Tokens.text-small;
                        color: Tokens.caution-inverse;
                        height: root.dirty ? Tokens.space-4 : 0px;
                    }
                }
            }
        }

        VerticalLayout {
            // The content column, capped and centred: a wide window gives wide margins rather
            // than 900px-wide text fields. The width is declared once here and handed to the views
            // that need to know it — a ScrollView positioned outside a layout reports its own
            // visible-width as zero, so it cannot measure itself.
            content := Rectangle {

                config-tab := ConfigTab {
                    // Every view is instantiated; the rail chooses which is drawn.
                    visible: root.current-view == 0;
                    x: (parent.width - root.column-width) / 2;
                    width: root.column-width;
                    height: parent.height;
                    sources: root.sources;
                    keychain-available: root.keychain-available;
                    keychain-problem: root.keychain-problem;
                    exclude-schemas-text <=> root.exclude-schemas-text;
                    connect-timeout-seconds <=> root.connect-timeout-seconds;
                    statement-timeout-seconds <=> root.statement-timeout-seconds;
                    lock-timeout-seconds <=> root.lock-timeout-seconds;
                    parallel <=> root.parallel;
                    max-workers <=> root.max-workers;
                    fail-on <=> root.fail-on;
                    ignore-column-order <=> root.ignore-column-order;
                    include-owners <=> root.include-owners;
                    include-comments <=> root.include-comments;
                    include-grants <=> root.include-grants;

                    source-changed(l, f, v) => { root.source-changed(l, f, v); }
                    config-changed(f, v) => { root.config-changed(f, v); }
                    add-target => { root.add-target(); }
                    remove-target(l) => { root.remove-target(l); }
                    check-connection(l) => { root.check-connection(l); }
                    store-password(l, s) => { root.store-password(l, s); }
                    forget-password(l) => { root.forget-password(l); }
                    test-tunnel(l) => { root.test-tunnel(l); }
                    choose-ssh-key(l) => { root.choose-ssh-key(l); }
                    select-source-tab(l, i) => { root.select-source-tab(l, i); }
                    check-all => { root.check-all(); }
                    validate-config => { root.validate-config(); }
                    save-config => { root.save-config(); }
                    }

                run-tab := RunTab {
                    // Every view is instantiated; the rail chooses which is drawn.
                    visible: root.current-view == 1;
                    x: (parent.width - root.column-width) / 2;
                    width: root.column-width;
                    height: parent.height;
                    running <=> root.running;
                    progress: root.progress;
                    run-fail-on <=> root.run-fail-on;
                    baseline-path <=> root.baseline-path;
                    show-cosmetic <=> root.show-cosmetic;
                    skip-liquibase <=> root.skip-liquibase;
                    strict-changelog <=> root.strict-changelog;
                    no-default-ignores <=> root.no-default-ignores;
                    allow-unreachable <=> root.allow-unreachable;
                    sequential <=> root.sequential;

                    start-run => { root.start-run(); }
                    cancel-run => { root.cancel-run(); }
                    choose-baseline => { root.choose-baseline(); }
                    }

                results-tab := ResultsTab {
                    column-width: root.column-width;
                    // Every view is instantiated; the rail chooses which is drawn.
                    visible: root.current-view == 2;
                    x: (parent.width - root.column-width) / 2;
                    width: root.column-width;
                    height: parent.height;
                    running: root.running;
                    verdict: root.verdict;
                    verdict-level: root.verdict-level;
                    findings: root.findings;
                    total-findings: root.total-findings;
                    selected-heading: root.selected-heading;
                    selected-deltas: root.selected-deltas;
                    selected-diff: root.selected-diff;
                    filter-text <=> root.filter-text;
                    show-error <=> root.show-error;
                    show-warning <=> root.show-warning;
                    show-info <=> root.show-info;
                    output-directory <=> root.output-directory;

                    filter-changed => { root.filter-changed(); }
                    select-finding(t, k, p) => { root.select-finding(t, k, p); }
                    choose-output-directory => { root.choose-output-directory(); }
                    output-directory-changed(v) => { root.config-changed("output_dir", v); }
                    write-reports => { root.write-reports(); }
                    open-html => { root.open-html(); }
                    }

                ignores-tab := IgnoresTab {
                    // Every view is instantiated; the rail chooses which is drawn.
                    visible: root.current-view == 3;
                    x: (parent.width - root.column-width) / 2;
                    width: root.column-width;
                    height: parent.height;
                    rules: root.rules;
                    default-rules: root.default-rules;
                    case-insensitive-globs <=> root.case-insensitive-globs;

                    rule-changed(i, f, v) => { root.rule-changed(i, f, v); }
                    add-rule => { root.add-rule(); }
                    remove-rule(i) => { root.remove-rule(i); }
                    save-ignores => { root.save-ignores(); }
                    }

                about-tab := AboutTab {
                    // Every view is instantiated; the rail chooses which is drawn.
                    visible: root.current-view == 4;
                    x: (parent.width - root.column-width) / 2;
                    width: root.column-width;
                    height: parent.height;

                    version: root.about-version;
                    python-version: root.about-python;
                    slint-version: root.about-slint;
                    config-path: root.about-config-path;
                    tunnelling-available: root.about-tunnelling;
                }

                // Drawn last, so it floats over whichever view is showing rather than displacing
                // it. Bottom right, clear of the rail.
                toast := Toast {
                    message: root.status-message;
                    is-error: root.status-is-error;
                    token: root.status-token;
                    width: min(420px, parent.width - 2 * Tokens.space-5);
                    x: parent.width - self.width - Tokens.space-5;
                    y: parent.height - self.height - Tokens.space-5;
                }
            }
        }
    }

    // Last, so it draws over the rail as well as the content: a modal that leaves part of the
    // window reachable is not one.
    dialog := TunnelDialog {
        width: parent.width;
        height: parent.height;
        open: root.tunnel-open;
        busy: root.tunnel-busy;
        ok: root.tunnel-ok;
        gateway: root.tunnel-gateway;
        summary: root.tunnel-summary;
        steps: root.tunnel-steps;
        close => { root.close-tunnel-dialog(); }
    }

    // After the tunnel dialog: a comparison cannot be started while that one is up, so the two
    // never overlap, and whichever is last would cover the other anyway.
    run-dialog := RunDialog {
        width: parent.width;
        height: parent.height;
        open: root.run-open;
        busy: root.run-busy;
        title: root.run-title;
        inputs: root.run-inputs;
        steps: root.run-steps;
        summary: root.run-summary;
        summary-level: root.run-summary-level;
        cancel => { root.cancel-run(); }
        close => { root.close-run-dialog(); }
        show-results => { root.show-run-results(); }
    }
}
