// Credentials. This tab never holds a connection string: a row carries the variable name, who uses
// it, where it resolved from, and a redacted summary. The only secret that ever touches it is the
// one typed into the masked field, which goes out through store-credential and is cleared at once.

import { LineEdit, Button, ScrollView, GroupBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";

export struct CredentialRow {
    env_name: string,
    used_by: string,
    source: string,    // keychain | environment | unset
    summary: string,   // Dsn.safe_summary(): never the DSN
    can_store: bool,
}

export component CredentialLine inherits Rectangle {
    in property <CredentialRow> data;
    in property <bool> keychain-available;
    callback store(string);
    callback forget();

    VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-1;
        HorizontalLayout {
            spacing: Tokens.space-2;
            Text {
                text: root.data.env_name;
                width: 180px;
                vertical-alignment: center;
                font-family: Tokens.family-mono;
                color: Tokens.heading;
            }
            Text {
                text: root.data.used_by;
                width: 160px;
                vertical-alignment: center;
                color: Tokens.body;
            }
            Text {
                text: root.data.source;
                width: 90px;
                vertical-alignment: center;
                font-family: Tokens.family-mono;
                color: Tokens.muted;
            }
            Text {
                text: root.data.summary;
                vertical-alignment: center;
                font-family: Tokens.family-mono;
                color: Tokens.muted;
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-2;
            secret := LineEdit {
                input-type: password;
                placeholder-text: "new connection string";
                enabled: root.keychain-available && root.data.can-store;
            }
            Button {
                text: "Store";
                enabled: root.keychain-available && root.data.can-store && secret.text != "";
                clicked => {
                    root.store(secret.text);
                    secret.text = "";
                }
            }
            Button { text: "Forget"; clicked => { root.forget(); } }
        }
    }
}

export component CredentialsTab inherits ScrollView {
    in property <[CredentialRow]> credentials;
    in property <bool> keychain-available;
    in property <string> keychain-problem;

    callback store-credential(string, string);   // env name, secret (inbound only)
    callback forget-credential(string);

    out property <int> row-count: root.credentials.length;

    // The one path a typed secret takes out of this tab. Every Store click goes through here.
    public function submit(env-name: string, secret: string) {
        root.store-credential(env-name, secret);
    }

    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-3;

        Text {
            text: root.keychain-problem;
            font-weight: Tokens.weight-bold;
            color: Tokens.danger;
            visible: !root.keychain-available;
            height: root.keychain-available ? 0px : 24px;
        }

        GroupBox {
            title: "Connection strings";
            VerticalLayout {
                spacing: Tokens.space-2;
                for row[i] in root.credentials: CredentialLine {
                    background: mod(i, 2) == 0 ? transparent : Tokens.stripe;
                    data: row;
                    keychain-available: root.keychain-available;
                    store(s) => { root.submit(row.env_name, s); }
                    forget => { root.forget-credential(row.env_name); }
                }
            }
        }
    }
}
