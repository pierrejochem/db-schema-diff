// The design system, in one place. Every colour, size, radius and spacing step in this UI comes
// from here; no other `.slint` file may carry a colour literal or a bare font size.
//
// Why a global rather than a set of constants per file: a global is a singleton Slint shares across
// every file that imports it, so one edit here moves every consumer. The suite proves that by
// setting a token to an absurd value in a copy of the markup and asserting the consumers follow —
// a consumer holding its own copy of a literal would not move, and would be caught.
//
// Two colour families, deliberately separate:
//
//   * the signal names (`success`, `caution`, `danger`, `info`) are **ink** — text and icon colours,
//     darkened from the design system's traffic-signal palette (go #23b26d, caution #f5a623,
//     stop #e5484d, info #2f6fc4) so they clear 4.5:1 against their own surface. The signal values
//     themselves are tuned for fills and indicators and are unreadable as small text on a tint.
//   * the `-surface` names are the tints those inks sit on.
//
// Fonts: the three families are bundled with the package and installed by `gui/fonts.py` before
// Slint starts. A family Slint cannot resolve falls back silently, so the names here must match the
// bundled faces exactly — Archivo is bundled at 700 only and IBM Plex Mono at 400 only, which is
// why `weight-bold` always accompanies `family-display`.
//
// Nothing unused lives here. A token no consumer reads is a decision nobody made, and the suite
// rejects one, so the file stays a record of what this UI actually does.
export global Tokens {
    // The steel foundation. The navigation rail is a dark steel surface, so what sits on it is the
    // inverse ink and the rail's own selected and hover states are steps of the same hue.
    out property <color> steel: #1d2d3d;
    out property <color> steel-rail: #1d2d3d;
    out property <color> steel-selected: #2c455d;
    out property <color> inverse: #ffffff;
    // Caution, lightened for the steel rail: the light-scheme amber is unreadable on it.
    out property <color> caution-inverse: #f5cf6b;
    // The light end of the steel accent ramp: it marks the selected view and the master source, and
    // is the one accent that reads on the dark rail.
    out property <color> accent-light: #b5d9fd;

    // The accent, as ink. The theme's accent #5980a6 is 3:1 against the ground, enough for chrome
    // but not for small text, so text takes the 700 step of the same ramp (#416180, 5.5:1). The
    // HTML report's links read it, and the two are held equal.
    out property <color> accent: #416180;

    // Text.
    out property <color> heading: #1d2d3d;
    out property <color> body: #1d1f20;
    out property <color> muted: #5d5d60;
    // The light accent is a light colour: what sits on it is steel, never white.

    // Surfaces and lines.
    out property <color> page: #f2f2f3;
    out property <color> card: #ffffff;
    // Likewise reached only through the report, as its panel surface.
    out property <color> sunken: #e9e9ea;
    // Zebra striping. Translucent on purpose: a row stripe tints whatever surface is beneath it.
    out property <color> stripe: #1d2d3d0a;
    // The scrim behind a modal: dark enough to say the rest is not in play, light enough
    // that what it covers stays readable.
    out property <color> scrim: #1d2d3dcc;
    out property <color> hairline: #d4d4d7;

    // Signal ink.
    out property <color> success: #15794a;
    out property <color> caution: #8a5a00;
    out property <color> danger: #b02a30;
    out property <color> info: #2c455d;

    // Signal surfaces.
    out property <color> success-surface: #dcf6e8;
    out property <color> caution-surface: #fdf0d8;
    out property <color> danger-surface: #fce4e5;
    out property <color> info-surface: #d6ebff;
    out property <color> neutral-surface: #e7e7ea;

    // Type families.
    out property <string> family-display: "Archivo";
    out property <string> family-body: "Mulish";
    out property <string> family-mono: "IBM Plex Mono";

    // Weights. Only these two are bundled; anything between them is synthesised by the renderer.
    out property <int> weight-regular: 400;
    out property <int> weight-bold: 700;

    // Type scale.
    // 11px uppercase with the caps tracking: the section label above every card.
    out property <length> text-eyebrow: 11px;
    out property <length> text-small: 12px;
    out property <length> text-body: 13px;
    out property <length> text-control: 15px;
    out property <length> text-lead: 17px;

    // Tracking. Absolute rather than em-relative because Slint's letter-spacing is a length; these
    // are tuned for the two sizes that use them — eyebrows at 11px and headings at 15-17px.
    out property <length> tracking-tight: -0.4px;
    // Tuned for text-eyebrow: 0.12em of 11px.
    out property <length> tracking-caps: 1.3px;

    // Shape.
    out property <length> radius-subtle: 4px;
    out property <length> radius-card: 12px;
    out property <length> radius-pill: 999px;
    out property <length> hairline-width: 1px;

    // Layout. The content column takes the whole window, and the label column is one width for
    // every form in every view — which is what makes fields line up when you move between them.
    out property <length> rail-width: 184px;
    out property <length> label-column: 180px;
    out property <length> field-max: 420px;
    out property <length> row-height: 36px;
    out property <length> pill-height: 20px;
    // The findings list's columns. The header and every row read these, so they cannot drift apart.
    out property <length> col-target: 80px;
    out property <length> col-kind: 70px;
    out property <length> col-status: 90px;
    out property <length> col-pill: 80px;

    // Spacing, on a 4px grid.
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
}
