// Shared building blocks. Kept in one file because they are small and always change together.

import { LineEdit, CheckBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";

export component LabelledField inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    callback edited(string);

    spacing: Tokens.space-2;
    Text {
        text: root.label;
        width: 140px;
        vertical-alignment: center;
        font-size: Tokens.text-body;
        color: Tokens.muted;
    }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        edited(text) => { root.edited(text); }
    }
}

export component LabelledNumber inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    callback edited(int);

    spacing: Tokens.space-2;
    Text {
        text: root.label;
        width: 220px;
        vertical-alignment: center;
        font-size: Tokens.text-body;
        color: Tokens.muted;
    }
    LineEdit {
        text: root.value;
        input-type: number;
        edited(text) => {
            root.value = text.to-float();
            root.edited(text.to-float());
        }
    }
}

export component LabelledCheck inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> value;
    callback toggled(bool);

    spacing: Tokens.space-2;
    CheckBox { checked <=> root.value; toggled => { root.toggled(self.checked); } }
    Text {
        text: root.label;
        vertical-alignment: center;
        overflow: elide;
        font-size: Tokens.text-body;
        color: Tokens.body;
    }
}

// What just happened, floating over the content instead of taking a strip of it.
//
// A failure stays until it is dismissed or replaced. Anything else clears itself after a few
// seconds — but an error that vanished on a timer would be a report of a problem nobody read, and
// this application's errors are the whole point of it.
export component Toast inherits Rectangle {
    in property <string> message;
    in property <bool> is-error;
    //: Bumped by the application for every message. Without it, the same text twice — two failed
    //: connection checks of the same source, say — would show once, because nothing changed.
    in property <int> token;
    //: The token whose message has been seen off, by the timer or by the person.
    private property <int> settled;

    out property <bool> showing: root.message != "" && root.token != root.settled;
    out property <string> shown: root.showing ? root.message : "";
    public function dismiss() { root.settled = root.token; }

    //: How long a non-error stays. Long enough to read a sentence, short enough not to sit there.
    in property <duration> linger: 5s;

    // The width is set where this is placed: a component's own root has no parent to measure.
    height: max(48px, body.preferred-height + 2 * Tokens.space-3);
    visible: root.showing;
    background: root.is-error ? Tokens.danger-surface : Tokens.success-surface;
    border-radius: Tokens.radius-card;
    border-width: Tokens.hairline-width;
    border-color: root.is-error ? Tokens.danger : Tokens.success;

    dismiss-after := Timer {
        interval: root.linger;
        running: root.showing && !root.is-error;
        triggered => { root.dismiss(); }
    }

    HorizontalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        body := Text {
            text: root.message;
            color: root.is-error ? Tokens.danger : Tokens.success;
            vertical-alignment: center;
            font-size: Tokens.text-body;
            font-weight: Tokens.weight-bold;
            wrap: word-wrap;
        }
        // An error waits for this; everything else is already on its way out.
        Rectangle {
            width: 24px;
            close := TouchArea { clicked => { root.dismiss(); } }
            Text {
                text: "✕";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Tokens.text-body;
                color: close.has-hover
                    ? (root.is-error ? Tokens.danger : Tokens.success)
                    : Tokens.muted;
            }
        }
    }
}

// The design system's section label: 11px, uppercase, blue, with the caps tracking. Slint has no
// text-transform, so the text arrives already uppercase from the markup.
export component Eyebrow inherits Text {
    font-size: Tokens.text-eyebrow;
    font-weight: Tokens.weight-bold;
    letter-spacing: Tokens.tracking-caps;
    color: Tokens.blue;
}

// The same label on the navy rail. Blue on navy fails contrast, so the rail's eyebrows are lime.
export component RailLabel inherits Text {
    font-size: Tokens.text-eyebrow;
    font-weight: Tokens.weight-bold;
    letter-spacing: Tokens.tracking-caps;
    color: Tokens.lime;
}

// A section: a card surface with an eyebrow heading. Cards never nest — a card inside a card reads
// as the framed group box this replaced.
export component Card inherits Rectangle {
    in property <string> title;

    background: Tokens.card;
    border-radius: Tokens.radius-card;
    border-width: Tokens.hairline-width;
    border-color: Tokens.hairline;

    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;
        if root.title != "": Eyebrow { text: root.title; }
        @children
    }
}

// The severity of one finding, as a pill. A word in a coloured column is easy to lose in a list;
// a filled pill is not, and the shape is the design system's signature.
export component SeverityPill inherits Rectangle {
    in property <string> severity;

    width: Tokens.col-pill;
    height: Tokens.pill-height;
    border-radius: Tokens.radius-pill;
    background: root.severity == "error" ? Tokens.danger-surface
        : root.severity == "warning" ? Tokens.caution-surface
        : root.severity == "info" ? Tokens.info-surface
        : Tokens.neutral-surface;

    Text {
        // Uppercase by mapping, since Slint has no text-transform. An unrecognised severity shows
        // its own value rather than nothing: this is a report of what the run found.
        text: root.severity == "error" ? "ERROR"
            : root.severity == "warning" ? "WARNING"
            : root.severity == "info" ? "INFO"
            : root.severity;
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Tokens.text-eyebrow;
        font-weight: Tokens.weight-bold;
        letter-spacing: Tokens.tracking-caps;
        color: root.severity == "error" ? Tokens.danger
            : root.severity == "warning" ? Tokens.caution
            : root.severity == "info" ? Tokens.info
            : Tokens.muted;
    }
}

// One form row, and the reason anything lines up: every label in every view is this width and this
// alignment, so moving between tabs does not move the fields.
export component FormRow inherits HorizontalLayout {
    in property <string> label;

    spacing: Tokens.space-3;
    Text {
        text: root.label;
        width: Tokens.label-column;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Tokens.text-body;
        color: Tokens.muted;
    }
    @children
}

// A column heading over a list. Same type as the card eyebrow, muted rather than blue: it labels a
// column of values rather than opening a section.
export component ColumnHead inherits Text {
    font-size: Tokens.text-eyebrow;
    font-weight: Tokens.weight-bold;
    letter-spacing: Tokens.tracking-caps;
    color: Tokens.muted;
    vertical-alignment: center;
    overflow: elide;
}

// One entry in the navigation rail.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    background: root.selected ? Tokens.navy-selected
        : touch.has-hover ? Tokens.navy-selected.with-alpha(0.5) : transparent;

    touch := TouchArea { clicked => { root.clicked(); } }

    // The selected view is marked in lime, the signature accent, rather than by fill alone.
    Rectangle {
        x: 0;
        width: root.selected ? Tokens.space-1 : 0px;
        background: Tokens.lime;
    }
    Text {
        x: Tokens.space-4;
        text: root.label;
        vertical-alignment: center;
        font-size: Tokens.text-control;
        font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-regular;
        color: Tokens.inverse;
    }
}
