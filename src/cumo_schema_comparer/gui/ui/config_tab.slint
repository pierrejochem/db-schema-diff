// Every field of ComparerConfig, SourceRef and Options.
//
// Every field is labelled from the shared label column, so nothing here depends on a placeholder
// the user has already typed over. Each source is its own card rather than a row in a striped
// block: a source carries nine fields and a connection result, which is a record, not a row.

import { LineEdit, ComboBox, Button, ScrollView } from "std-widgets.slint";
import { LabelledCheck, Card, FormRow, Eyebrow } from "widgets.slint";
import { Tokens } from "tokens.slint";

export struct SourceRow {
    label: string,
    host: string,
    port: string,
    database: string,
    user: string,
    sslmode: string,
    // Whether a password is in the keychain for this source. Never the password: nothing about a
    // stored secret crosses into the window but the fact that one exists.
    has_password: bool,
    // What the connection still lacks, already worded, or "" when it lacks nothing.
    missing: string,
    schemas: string,          // comma-separated; the view model splits and joins
    schema_map: string,       // "from=to, from=to"
    liquibase_schema: string,
    liquibase_table: string,
    // The gateway to reach this source through; empty means connect directly. The key is a path
    // and the passphrase is a variable *name* — neither is ever a secret in itself.
    ssh_host: string,
    ssh_user: string,
    ssh_key: string,
    ssh_passphrase_env: string,
    // Which tab this card is showing. It lives in the row rather than in the card because every
    // refresh replaces the model, and a card's own property would be rebuilt back to zero —
    // cancelling a file dialog would send you back to the Database tab.
    tab: int,
    is_master: bool,
    connection_status: string,
    connection_ok: bool,
    checked: bool,
}

// One segment of a source card's tab strip. A pill rather than a std-widget tab, because the card
// already has a frame and a second frame inside it reads as the group box this layout replaced.
component CardTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: Tokens.row-height;
    width: text.preferred-width + 2 * Tokens.space-4;
    border-radius: Tokens.radius-pill;
    background: root.selected ? Tokens.heading
        : touch.has-hover ? Tokens.stripe : transparent;

    touch := TouchArea { clicked => { root.clicked(); } }

    text := Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Tokens.text-body;
        font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-regular;
        color: root.selected ? Tokens.inverse : Tokens.muted;
    }
}

export component ConfigTab inherits ScrollView {
    in property <[SourceRow]> sources;
    in-out property <string> exclude-schemas-text;

    in-out property <int> connect-timeout-seconds;
    in-out property <int> statement-timeout-seconds;
    in-out property <int> lock-timeout-seconds;
    in-out property <bool> parallel;
    in-out property <int> max-workers;
    in-out property <string> fail-on;
    in-out property <bool> ignore-column-order;
    in-out property <bool> include-owners;
    in-out property <bool> include-comments;
    in-out property <bool> include-grants;

    callback source-changed(string, string, string);   // label, field, value
    // Separate from source-changed, not an empty label passed to it. A label is a field a
    // person types into and can backspace to nothing, and a source addressed by its label
    // would then be a source nothing could address.
    callback config-changed(string, string);           // field, value
    callback add-target();
    callback remove-target(string);
    callback check-connection(string);
    in property <bool> keychain-available;
    in property <string> keychain-problem;

    callback store-password(string, string);
    callback forget-password(string);

    // The one path a typed password takes out of this tab, and the one that drops a stored one.
    // Every Store and Forget goes through here, so a test can drive the real chain — a handler
    // assigned onto the outward callback from Python would replace the code under test.
    public function submit(label: string, secret: string) {
        root.store-password(label, secret);
    }
    public function drop(label: string) { root.forget-password(label); }
    callback test-tunnel(string);
    callback choose-ssh-key(string);
    callback select-source-tab(string, int);
    callback check-all();
    callback validate-config();
    callback save-config();

    VerticalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-4;
        alignment: start;

        // Without a keychain there is nowhere to put a password, which is worth saying once at the
        // top rather than leaving someone to find a Store button that does nothing.
        Rectangle {
            height: root.keychain-available ? 0px : Tokens.row-height;
            visible: !root.keychain-available;
            border-radius: Tokens.radius-subtle;
            background: Tokens.caution-surface;
            Text {
                x: Tokens.space-3;
                text: "No keychain: " + root.keychain-problem
                    + ". Passwords cannot be stored on this machine.";
                vertical-alignment: center;
                font-size: Tokens.text-body;
                color: Tokens.caution;
                overflow: elide;
            }
        }

        Card {
            title: "CONFIGURATION";
            FormRow {
                label: "exclude schemas";
                LineEdit {
                    text <=> root.exclude-schemas-text;
                    placeholder-text: "quartz, audit_archive";
                    max-width: Tokens.field-max;
                    edited(v) => { root.config-changed("exclude_schemas", v); }
                }
                Rectangle { }
            }
        }

        // One card per source, with its own heading, rather than one card holding striped rows:
        // cards do not nest, and the master needs a marker of its own.
        VerticalLayout {
            spacing: Tokens.space-2;
            Eyebrow { text: "SOURCES"; }

            for row[i] in root.sources: card := Rectangle {

                background: Tokens.card;
                border-radius: Tokens.radius-card;
                border-width: Tokens.hairline-width;
                border-color: row.is_master ? Tokens.heading : Tokens.hairline;
                // Clipped so the accent edge below follows the card's corners. A square bar at the
                // card's own left edge otherwise overhangs the two rounded corners. Giving the bar
                // its own corner radius does not work: 12px of radius on a 4px-wide rectangle
                // clamps into a tapered sliver rather than a bar that hugs the corner.
                clip: true;
                // The master is the reference every target is read against, so it carries the
                // accent edge as well as the word.
                Rectangle {
                    x: 0;
                    width: row.is_master ? Tokens.space-1 : 0px;
                    background: Tokens.lime;
                }
                VerticalLayout {
                    padding: Tokens.space-4;
                    spacing: Tokens.space-2;

                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        Text {
                            text: row.is_master ? "MASTER" : "TARGET";
                            font-size: Tokens.text-eyebrow;
                            font-weight: Tokens.weight-bold;
                            letter-spacing: Tokens.tracking-caps;
                            color: row.is_master ? Tokens.heading : Tokens.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Button {
                            text: "Check connection";
                            clicked => { root.check-connection(row.label); }
                        }
                        Button {
                            text: "Remove";
                            enabled: !row.is_master;
                            clicked => { root.remove-target(row.label); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tokens.space-1;
                        alignment: start;
                        CardTab {
                            label: "Database";
                            selected: row.tab == 0;
                            clicked => { root.select-source-tab(row.label, 0); }
                        }
                        CardTab {
                            // Says at a glance whether this source goes through a gateway, so the
                            // setting is not hidden behind a tab nobody thinks to open.
                            label: row.ssh_host == "" ? "SSH tunnel" : "SSH tunnel ·";
                            selected: row.tab == 1;
                            clicked => { root.select-source-tab(row.label, 1); }
                        }
                    }

                    if row.tab == 0: VerticalLayout {
                        spacing: Tokens.space-2;
                        FormRow {
                            label: "label";
                            LineEdit {
                                text: row.label;
                                max-width: Tokens.field-max;
                                edited(v) => { root.source-changed(row.label, "label", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "host";
                            LineEdit {
                                text: row.host;
                                max-width: Tokens.field-max;
                                placeholder-text: "db-qa.internal";
                                edited(v) => { root.source-changed(row.label, "host", v); }
                            }
                            LineEdit {
                                text: row.port;
                                width: 90px;
                                input-type: number;
                                placeholder-text: "5432";
                                edited(v) => { root.source-changed(row.label, "port", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "database";
                            LineEdit {
                                text: row.database;
                                max-width: Tokens.field-max;
                                placeholder-text: "invoicing";
                                edited(v) => { root.source-changed(row.label, "database", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "user";
                            LineEdit {
                                text: row.user;
                                max-width: Tokens.field-max;
                                placeholder-text: "cumo";
                                edited(v) => { root.source-changed(row.label, "user", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "password";
                            secret := LineEdit {
                                input-type: password;
                                max-width: Tokens.field-max;
                                placeholder-text: row.has_password
                                    ? "stored in the keychain" : "not stored yet";
                                // Cleared the moment it is handed over, so a typed password is never left
                                // sitting in a widget for anything to read back.
                                accepted => {
                                    root.submit(row.label, self.text);
                                    self.text = "";
                                }
                            }
                            Button {
                                text: "Store";
                                enabled: root.keychain-available && secret.text != "";
                                clicked => {
                                    root.submit(row.label, secret.text);
                                    secret.text = "";
                                }
                            }
                            Button {
                                text: "Forget";
                                enabled: row.has_password;
                                clicked => { root.drop(row.label); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "ssl mode";
                            ComboBox {
                                model: ["", "disable", "allow", "prefer", "require", "verify-ca", "verify-full"];
                                current-value: row.sslmode;
                                max-width: 200px;
                                selected(v) => { root.source-changed(row.label, "sslmode", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "";
                            Text {
                                text: row.missing == "" ? "" : "still needed: " + row.missing;
                                vertical-alignment: center;
                                font-size: Tokens.text-body;
                                color: Tokens.caution;
                                height: row.missing == "" ? 0px : Tokens.space-5;
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "schemas";
                            LineEdit {
                                text: row.schemas;
                                max-width: Tokens.field-max;
                                placeholder-text: "comma separated";
                                edited(v) => { root.source-changed(row.label, "schemas", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "schema map";
                            LineEdit {
                                text: row.schema_map;
                                max-width: Tokens.field-max;
                                placeholder-text: "master=target, master=target";
                                edited(v) => { root.source-changed(row.label, "schema_map", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "liquibase schema";
                            LineEdit {
                                text: row.liquibase_schema;
                                max-width: Tokens.field-max;
                                placeholder-text: "optional";
                                edited(v) => {
                                    root.source-changed(row.label, "liquibase_schema", v);
                                }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "liquibase table";
                            LineEdit {
                                text: row.liquibase_table;
                                max-width: Tokens.field-max;
                                placeholder-text: "DATABASECHANGELOG";
                                edited(v) => {
                                    root.source-changed(row.label, "liquibase_table", v);
                                }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "";
                            Text {
                                text: row.connection_status;
                                vertical-alignment: center;
                                font-weight: Tokens.weight-bold;
                                color: row.connection_ok ? Tokens.success : Tokens.danger;
                                visible: row.connection_status != "";
                                height: row.connection_status == "" ? 0px : Tokens.space-5;
                            }
                            Rectangle { }
                        }
                    }

                    if row.tab == 1: VerticalLayout {
                        spacing: Tokens.space-2;
                        FormRow {
                            label: "ssh gateway";
                            LineEdit {
                                text: row.ssh_host;
                                max-width: Tokens.field-max;
                                placeholder-text: "bastion.internal (optional)";
                                edited(v) => { root.source-changed(row.label, "ssh_host", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "ssh user";
                            LineEdit {
                                text: row.ssh_user;
                                max-width: Tokens.field-max;
                                placeholder-text: "defaults to your local user";
                                edited(v) => { root.source-changed(row.label, "ssh_user", v); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "ssh key";
                            LineEdit {
                                text: row.ssh_key;
                                max-width: Tokens.field-max;
                                placeholder-text: "~/.ssh/id_ed25519 (agent if empty)";
                                edited(v) => { root.source-changed(row.label, "ssh_key", v); }
                            }
                            Button {
                                text: "Choose…";
                                clicked => { root.choose-ssh-key(row.label); }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "ssh passphrase variable";
                            LineEdit {
                                text: row.ssh_passphrase_env;
                                max-width: Tokens.field-max;
                                placeholder-text: "QA_SSH_PASSPHRASE";
                                edited(v) => {
                                    root.source-changed(row.label, "ssh_passphrase_env", v);
                                }
                            }
                            Rectangle { }
                        }
                        FormRow {
                            label: "";
                            Button {
                                text: "Test tunnel";
                                enabled: row.ssh_host != "";
                                clicked => { root.test-tunnel(row.label); }
                            }
                            Rectangle { }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: start;
                Button { text: "Add target"; clicked => { root.add-target(); } }
                Button { text: "Check all"; clicked => { root.check-all(); } }
            }
        }

        // The options are grouped by what they govern. One flat list of ten controls is what made
        // this view hard to read.
        Card {
            title: "TIMEOUTS";
            VerticalLayout {
                spacing: Tokens.space-1;
                FormRow {
                    label: "connect";
                    LineEdit {
                        text: root.connect-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.connect-timeout-seconds = v.to-float();
                            root.config-changed("connect_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "statement";
                    LineEdit {
                        text: root.statement-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.statement-timeout-seconds = v.to-float();
                            root.config-changed("statement_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "lock";
                    LineEdit {
                        text: root.lock-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.lock-timeout-seconds = v.to-float();
                            root.config-changed("lock_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
            }
        }

        Card {
            title: "EXECUTION";
            VerticalLayout {
                spacing: Tokens.space-1;
                FormRow {
                    label: "max workers";
                    LineEdit {
                        text: root.max-workers;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.max-workers = v.to-float();
                            root.config-changed("max_workers", v);
                        }
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "fail on";
                    ComboBox {
                        model: ["error", "warning", "any", "never"];
                        current-value <=> root.fail-on;
                        max-width: 200px;
                        selected(v) => { root.config-changed("fail_on", v); }
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "";
                    LabelledCheck {
                        label: "parallel";
                        value <=> root.parallel;
                        toggled(v) => {
                            root.config-changed("parallel", v ? "true" : "false");
                        }
                    }
                    LabelledCheck {
                        label: "ignore column order";
                        value <=> root.ignore-column-order;
                        toggled(v) => {
                            root.config-changed("ignore_column_order", v ? "true" : "false");
                        }
                    }
                    Rectangle { }
                }
            }
        }

        Card {
            title: "INCLUDE";
            FormRow {
                label: "compare";
                LabelledCheck {
                    label: "owners";
                    value <=> root.include-owners;
                    toggled(v) => {
                        root.config-changed("include_owners", v ? "true" : "false");
                    }
                }
                LabelledCheck {
                    label: "comments";
                    value <=> root.include-comments;
                    toggled(v) => {
                        root.config-changed("include_comments", v ? "true" : "false");
                    }
                }
                LabelledCheck {
                    label: "grants";
                    value <=> root.include-grants;
                    toggled(v) => {
                        root.config-changed("include_grants", v ? "true" : "false");
                    }
                }
                Rectangle { }
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Button { text: "Validate"; clicked => { root.validate-config(); } }
            Button { text: "Save"; primary: true; clicked => { root.save-config(); } }
        }
    }
}
