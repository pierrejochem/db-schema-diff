// Every field of ComparerConfig, SourceRef and Options.
//
// Every field is labelled from the shared label column, so nothing here depends on a placeholder
// the user has already typed over. Each source is its own card rather than a row in a striped
// block: a source carries nine fields and a connection result, which is a record, not a row.

import { LineEdit, ComboBox, Button, ScrollView } from "std-widgets.slint";
import { LabelledCheck, Card, FormRow, Eyebrow } from "widgets.slint";
import { Tokens } from "tokens.slint";

export struct SourceRow {
    label: string,
    dsn_env: string,
    host: string,
    database: string,
    schemas: string,          // comma-separated; the view model splits and joins
    schema_map: string,       // "from=to, from=to"
    liquibase_schema: string,
    liquibase_table: string,
    is_master: bool,
    credential_source: string,   // keychain | environment | unset
    connection_status: string,
    connection_ok: bool,
    checked: bool,
}

export component ConfigTab inherits ScrollView {
    in-out property <string> config-name;
    in property <[SourceRow]> sources;
    in-out property <string> exclude-schemas-text;

    in-out property <int> connect-timeout-seconds;
    in-out property <int> statement-timeout-seconds;
    in-out property <int> lock-timeout-seconds;
    in-out property <bool> parallel;
    in-out property <int> max-workers;
    in-out property <string> fail-on;
    in-out property <bool> ignore-column-order;
    in-out property <bool> include-owners;
    in-out property <bool> include-comments;
    in-out property <bool> include-grants;

    callback source-changed(string, string, string);   // label, field, value
    callback add-target();
    callback remove-target(string);
    callback check-connection(string);
    callback check-all();
    callback validate-config();
    callback save-config();

    VerticalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-4;
        alignment: start;

        Card {
            title: "CONFIGURATION";
            FormRow {
                label: "name";
                LineEdit {
                    text <=> root.config-name;
                    placeholder-text: "invoicing";
                    max-width: Tokens.field-max;
                    edited(v) => { root.source-changed("", "name", v); }
                }
                Rectangle { }
            }
            FormRow {
                label: "exclude schemas";
                LineEdit {
                    text <=> root.exclude-schemas-text;
                    placeholder-text: "quartz, audit_archive";
                    max-width: Tokens.field-max;
                    edited(v) => { root.source-changed("", "exclude_schemas", v); }
                }
                Rectangle { }
            }
        }

        // One card per source, with its own heading, rather than one card holding striped rows:
        // cards do not nest, and the master needs a marker of its own.
        VerticalLayout {
            spacing: Tokens.space-2;
            Eyebrow { text: "SOURCES"; }

            for row[i] in root.sources: Rectangle {
                background: Tokens.card;
                border-radius: Tokens.radius-card;
                border-width: Tokens.hairline-width;
                border-color: row.is_master ? Tokens.heading : Tokens.hairline;
                // The master is the reference every target is read against, so it carries the
                // accent edge as well as the word.
                Rectangle {
                    x: 0;
                    width: row.is_master ? Tokens.space-1 : 0px;
                    background: Tokens.lime;
                }
                VerticalLayout {
                    padding: Tokens.space-4;
                    spacing: Tokens.space-2;

                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        Text {
                            text: row.is_master ? "MASTER" : "TARGET";
                            font-size: Tokens.text-eyebrow;
                            font-weight: Tokens.weight-bold;
                            letter-spacing: Tokens.tracking-caps;
                            color: row.is_master ? Tokens.heading : Tokens.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Button {
                            text: "Check connection";
                            clicked => { root.check-connection(row.label); }
                        }
                        Button {
                            text: "Remove";
                            enabled: !row.is_master;
                            clicked => { root.remove-target(row.label); }
                        }
                    }

                    FormRow {
                        label: "label";
                        LineEdit {
                            text: row.label;
                            max-width: Tokens.field-max;
                            edited(v) => { root.source-changed(row.label, "label", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "dsn variable";
                        LineEdit {
                            text: row.dsn_env;
                            max-width: Tokens.field-max;
                            placeholder-text: "PROD_DSN";
                            edited(v) => { root.source-changed(row.label, "dsn_env", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "credential";
                        Text {
                            text: row.credential_source;
                            vertical-alignment: center;
                            font-family: Tokens.family-mono;
                            color: Tokens.muted;
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "host";
                        LineEdit {
                            text: row.host;
                            max-width: Tokens.field-max;
                            placeholder-text: "documentation only";
                            edited(v) => { root.source-changed(row.label, "host", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "database";
                        LineEdit {
                            text: row.database;
                            max-width: Tokens.field-max;
                            placeholder-text: "documentation only";
                            edited(v) => { root.source-changed(row.label, "database", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "schemas";
                        LineEdit {
                            text: row.schemas;
                            max-width: Tokens.field-max;
                            placeholder-text: "comma separated";
                            edited(v) => { root.source-changed(row.label, "schemas", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "schema map";
                        LineEdit {
                            text: row.schema_map;
                            max-width: Tokens.field-max;
                            placeholder-text: "master=target, master=target";
                            edited(v) => { root.source-changed(row.label, "schema_map", v); }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "liquibase schema";
                        LineEdit {
                            text: row.liquibase_schema;
                            max-width: Tokens.field-max;
                            placeholder-text: "optional";
                            edited(v) => {
                                root.source-changed(row.label, "liquibase_schema", v);
                            }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "liquibase table";
                        LineEdit {
                            text: row.liquibase_table;
                            max-width: Tokens.field-max;
                            placeholder-text: "DATABASECHANGELOG";
                            edited(v) => {
                                root.source-changed(row.label, "liquibase_table", v);
                            }
                        }
                        Rectangle { }
                    }
                    FormRow {
                        label: "";
                        Text {
                            text: row.connection_status;
                            vertical-alignment: center;
                            font-weight: Tokens.weight-bold;
                            color: row.connection_ok ? Tokens.success : Tokens.danger;
                            visible: row.connection_status != "";
                            height: row.connection_status == "" ? 0px : Tokens.space-5;
                        }
                        Rectangle { }
                    }
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: start;
                Button { text: "Add target"; clicked => { root.add-target(); } }
                Button { text: "Check all"; clicked => { root.check-all(); } }
            }
        }

        // The options are grouped by what they govern. One flat list of ten controls is what made
        // this view hard to read.
        Card {
            title: "TIMEOUTS";
            VerticalLayout {
                spacing: Tokens.space-1;
                FormRow {
                    label: "connect";
                    LineEdit {
                        text: root.connect-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.connect-timeout-seconds = v.to-float();
                            root.source-changed("", "connect_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "statement";
                    LineEdit {
                        text: root.statement-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.statement-timeout-seconds = v.to-float();
                            root.source-changed("", "statement_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "lock";
                    LineEdit {
                        text: root.lock-timeout-seconds;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.lock-timeout-seconds = v.to-float();
                            root.source-changed("", "lock_timeout_seconds", v);
                        }
                    }
                    Text {
                        text: "seconds";
                        vertical-alignment: center;
                        font-size: Tokens.text-body;
                        color: Tokens.muted;
                    }
                    Rectangle { }
                }
            }
        }

        Card {
            title: "EXECUTION";
            VerticalLayout {
                spacing: Tokens.space-1;
                FormRow {
                    label: "max workers";
                    LineEdit {
                        text: root.max-workers;
                        input-type: number;
                        width: 90px;
                        edited(v) => {
                            root.max-workers = v.to-float();
                            root.source-changed("", "max_workers", v);
                        }
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "fail on";
                    ComboBox {
                        model: ["error", "warning", "any", "never"];
                        current-value <=> root.fail-on;
                        max-width: 200px;
                        selected(v) => { root.source-changed("", "fail_on", v); }
                    }
                    Rectangle { }
                }
                FormRow {
                    label: "";
                    LabelledCheck {
                        label: "parallel";
                        value <=> root.parallel;
                        toggled(v) => {
                            root.source-changed("", "parallel", v ? "true" : "false");
                        }
                    }
                    LabelledCheck {
                        label: "ignore column order";
                        value <=> root.ignore-column-order;
                        toggled(v) => {
                            root.source-changed("", "ignore_column_order", v ? "true" : "false");
                        }
                    }
                    Rectangle { }
                }
            }
        }

        Card {
            title: "INCLUDE";
            FormRow {
                label: "compare";
                LabelledCheck {
                    label: "owners";
                    value <=> root.include-owners;
                    toggled(v) => {
                        root.source-changed("", "include_owners", v ? "true" : "false");
                    }
                }
                LabelledCheck {
                    label: "comments";
                    value <=> root.include-comments;
                    toggled(v) => {
                        root.source-changed("", "include_comments", v ? "true" : "false");
                    }
                }
                LabelledCheck {
                    label: "grants";
                    value <=> root.include-grants;
                    toggled(v) => {
                        root.source-changed("", "include_grants", v ? "true" : "false");
                    }
                }
                Rectangle { }
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Button { text: "Validate"; clicked => { root.validate-config(); } }
            Button { text: "Save"; primary: true; clicked => { root.save-config(); } }
        }
    }
}
