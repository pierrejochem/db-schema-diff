// Results: the run-level verdict, the findings, and the report-writing buttons.
//
// The banner is driven by `verdict-level`, which the view model derives from the finished report
// (or from the run's cancellation), and by nothing else. It is green only for the exact level
// "ok" and only while no run is in flight; every unknown, empty or stale value is neutral.
// Per-source progress is never consulted: all sources can be captured and the run still cancelled.

import { LineEdit, Button, ScrollView } from "std-widgets.slint";
import { LabelledCheck, Card, ColumnHead, SeverityPill } from "widgets.slint";
import { Tokens } from "tokens.slint";

export struct FindingRow {
    target: string,
    kind: string,
    path: string,
    status: string,
    severity: string,
    detail: string,
    suppressed_by: string,
}

export struct DeltaRow {
    attribute: string,
    master: string,
    target: string,
    severity: string,
    note: string,
    is_body: bool,
}

export struct DiffLine {
    attribute: string,
    kind: string,
    text: string,
}

export component FindingLine inherits Rectangle {
    in property <FindingRow> data;
    callback clicked();

    // What the row has to say beyond its identity. Empty for most findings, and an ignored one
    // must never look like an unremarked one.
    property <string> footnote: root.data.suppressed_by == "" ? root.data.detail
        : root.data.detail + "  [ignored by " + root.data.suppressed_by + "]";

    border-radius: Tokens.radius-subtle;

    TouchArea { clicked => { root.clicked(); } }

    VerticalLayout {
        padding: Tokens.space-1;
        spacing: 0px;
        HorizontalLayout {
            spacing: Tokens.space-2;
            Text {
                text: root.data.target;
                width: Tokens.col-target;
                vertical-alignment: center;
                overflow: elide;
                color: Tokens.body;
            }
            Text {
                text: root.data.kind;
                width: Tokens.col-kind;
                vertical-alignment: center;
                overflow: elide;
                font-family: Tokens.family-mono;
                color: Tokens.muted;
            }
            Text {
                text: root.data.path;
                vertical-alignment: center;
                overflow: elide;
                font-family: Tokens.family-mono;
                color: Tokens.heading;
            }
            Text {
                text: root.data.status;
                width: Tokens.col-status;
                vertical-alignment: center;
                overflow: elide;
                font-family: Tokens.family-mono;
                color: Tokens.muted;
            }
            SeverityPill { severity: root.data.severity; }
        }
        // In a layout, because an `x` on a layout child is ignored: this is what puts the footnote
        // under the kind column and keeps it inside the row.
        if root.footnote != "": HorizontalLayout {
            padding-left: Tokens.col-target + Tokens.space-2;
            Text {
                text: root.footnote;
                font-size: Tokens.text-small;
                color: Tokens.muted;
                overflow: elide;
            }
        }
    }
}

export component ResultsTab inherits ScrollView {
    in property <bool> running;
    in property <string> verdict;
    in property <string> verdict-level;
    in property <[FindingRow]> findings;
    // How many findings the run produced before the filter. Lets the tab say what is hidden.
    in property <int> total-findings;
    in-out property <string> filter-text;
    in-out property <bool> show-error;
    in-out property <bool> show-warning;
    in-out property <bool> show-info;
    in-out property <string> output-directory;
    // The pane describes one finding, named by identity (target, kind, path) and never by index:
    // an index is only meaningful under the filter state it was clicked in.
    in property <string> selected-heading;
    in property <[DeltaRow]> selected-deltas;
    in property <[DiffLine]> selected-diff;
    // The width of the content column, handed down by the window. This view cannot
    // measure it itself: a ScrollView positioned outside a layout reports its own
    // visible-width as zero.
    in property <length> column-width;

    callback filter-changed();
    callback select-finding(string, string, string);
    callback choose-output-directory();
    callback output-directory-changed(string);
    callback write-reports();
    callback open-html();

    // "ok" | "error" | "warning" | "info" | "cancelled" | "pending". Anything the view model might
    // send that is not exactly "ok" can never produce the success banner.
    out property <string> banner-kind:
        root.running ? "pending"
        : root.verdict-level == "ok" ? "ok"
        : root.verdict-level == "error" ? "error"
        : root.verdict-level == "warning" ? "warning"
        : root.verdict-level == "info" ? "info"
        : root.verdict-level == "cancelled" ? "cancelled"
        : "pending";
    out property <bool> banner-is-success: root.banner-kind == "ok";
    // The only place a kind becomes a colour. The markup consumes these and nothing else.
    out property <color> banner-background:
        root.banner-kind == "ok" ? Tokens.success-surface
        : root.banner-kind == "info" ? Tokens.info-surface
        : root.banner-kind == "warning" ? Tokens.caution-surface
        : root.banner-kind == "error" || root.banner-kind == "cancelled" ? Tokens.danger-surface
        : Tokens.neutral-surface;
    out property <color> banner-text-color:
        root.banner-kind == "ok" ? Tokens.success
        : root.banner-kind == "info" ? Tokens.info
        : root.banner-kind == "warning" ? Tokens.caution
        : root.banner-kind == "error" || root.banner-kind == "cancelled" ? Tokens.danger
        : Tokens.body;
    out property <int> finding-count: root.findings.length;
    out property <int> delta-count: root.selected-deltas.length;
    out property <int> diff-count: root.selected-diff.length;

    // The only place a diff line kind becomes a colour; text and tint both read it.
    pure function diff-colour(kind: string) -> color {
        return kind == "added" ? Tokens.success
            : kind == "removed" ? Tokens.danger
            : kind == "hunk" || kind == "elided" ? Tokens.muted
            : Tokens.body;
    }
    // A diff line opens a group when its attribute differs from the line before it. The pane
    // relies on the view model emitting rows grouped by attribute: for a, b, a it labels all three.
    pure public function starts-group(index: int) -> bool {
        return index == 0 || root.selected-diff[index].attribute
            != root.selected-diff[index - 1].attribute;
    }
    out property <string> heading-shown: heading-text.text;
    pure public function diff-colour-for(kind: string) -> color { return root.diff-colour(kind); }

    // A report exists to write only for a finished run that produced one. A cancelled run, a run
    // in flight and a window that has never run have none.
    out property <bool> has-report:
        !root.running && (root.verdict-level == "ok" || root.verdict-level == "error"
            || root.verdict-level == "warning" || root.verdict-level == "info");
    out property <bool> reports-enabled: root.has-report;

    // Shown-of-total, and an explicit statement when the filter is hiding rows. An empty list
    // must never be readable as "nothing wrong".
    out property <int> hidden-count:
        root.total-findings > root.findings.length ? root.total-findings - root.findings.length : 0;
    out property <bool> filter-active:
        root.filter-text != "" || !root.show-error || !root.show-warning || !root.show-info;
    out property <bool> filter-hides-rows: root.hidden-count > 0;
    out property <string> findings-summary:
        root.running ? ""
        : root.filter-hides-rows
            ? "Showing " + root.findings.length + " of " + root.total-findings
                + " findings. " + root.hidden-count + " hidden by the active filter"
                + " - clear it to see them."
        : root.total-findings == 0 && root.findings.length == 0 ? "No findings."
        : "Showing " + root.findings.length + " of "
            + (root.total-findings > root.findings.length ? root.total-findings
                : root.findings.length) + " findings.";

    // Test and click entry points: they go through the real LineEdit / CheckBox handlers.
    public function type-filter(value: string) {
        filter-edit.text = value;
        filter-edit.edited(value);
    }
    public function toggle-error(value: bool) { error-check.value = value; error-check.toggled(value); }
    public function toggle-warning(value: bool) { warning-check.value = value; warning-check.toggled(value); }
    public function toggle-info(value: bool) { info-check.value = value; info-check.toggled(value); }
    public function type-output-directory(value: string) { output-edit.text = value; }
    out property <string> filter-shown: filter-edit.text;
    out property <bool> error-shown: error-check.value;
    out property <bool> warning-shown: warning-check.value;
    out property <bool> info-shown: info-check.value;
    out property <string> output-directory-shown: output-edit.text;

    // The click path: the identity is read from the row the user clicked, in the model as it
    // stands at click time, and leaves through the one outward callback.
    public function choose-row(index: int) {
        root.select-finding(root.findings[index].target, root.findings[index].kind,
            root.findings[index].path);
    }

    out property <length> diff-viewport-width: diff-scroll.content-width;
    out property <length> diff-pane-width: diff-scroll.width;
    out property <length> diff-pane-height: diff-scroll.height;
    out property <length> tab-min-width: root.min-width;
    // x, y, width, height of each pane, so a test can see that they do not overlap in either
    // arrangement. Hand-set geometry has no layout guaranteeing that for it.
    out property <[length]> findings-box: [
        findings-card.x, findings-card.y, findings-card.width, findings-card.height];
    out property <[length]> detail-box: [
        detail-card.x, detail-card.y, detail-card.width, detail-card.height];
    // The findings list and the detail pane divide the content column in these proportions.
    // Detail takes the larger share because it holds the diff.
    out property <int> findings-share: 48;
    out property <int> detail-share: 52;
    // Below this the two stack instead. Measured against the ScrollView's own viewport, never
    // against root.width: a width derived from content inside a ScrollView is a binding loop.
    out property <length> split-at: 1000px;
    out property <bool> side-by-side: root.column-width >= root.split-at;
    // What the detail card has inside its padding, in either arrangement. The delta table's
    // columns are carved out of this: fixed widths summing to more than it paint over the edge.
    out property <length> detail-inner:
        (root.side-by-side
            ? (root.column-width - 2 * Tokens.space-5 - Tokens.space-4) * root.detail-share / 100
            : root.column-width - 2 * Tokens.space-5)
        - 2 * Tokens.space-4;
    out property <length> delta-attribute-width: 140px;
    out property <length> delta-severity-width: 70px;
    // Master, target and note share what the fixed columns leave.
    out property <length> delta-column-width: max(48px,
        (root.detail-inner - root.delta-attribute-width - root.delta-severity-width
            - 4 * Tokens.space-2) / 3);

    public function request-filter-changed() { root.filter-changed(); }
    public function request-choose-output-directory() { root.choose-output-directory(); }
    public function request-write-reports() {
        if (root.reports-enabled) { root.write-reports(); }
    }
    public function request-open-html() {
        if (root.reports-enabled) { root.open-html(); }
    }

    VerticalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-4;
        alignment: start;

        Rectangle {
            height: 64px;
            border-radius: Tokens.radius-card;
            border-width: Tokens.hairline-width;
            border-color: root.banner-text-color;
            background: root.banner-background;
            Text {
                x: Tokens.space-4;
                width: parent.width - 2 * Tokens.space-4;
                text: root.running ? "Run in progress…"
                    : root.verdict == "" ? "No comparison has finished yet." : root.verdict;
                vertical-alignment: center;
                wrap: word-wrap;
                font-family: Tokens.family-display;
                font-size: Tokens.text-lead;
                font-weight: Tokens.weight-bold;
                letter-spacing: Tokens.tracking-tight;
                color: root.banner-text-color;
            }
        }

        Card {
            title: "FILTER";
            VerticalLayout {
                spacing: Tokens.space-2;
                HorizontalLayout {
                    spacing: Tokens.space-3;
                    filter-edit := LineEdit {
                        text <=> root.filter-text;
                        placeholder-text: "filter by object path, e.g. invoice";
                        max-width: Tokens.field-max;
                        edited(t) => { root.request-filter-changed(); }
                    }
                    error-check := LabelledCheck {
                        label: "error";
                        value <=> root.show-error;
                        toggled(v) => { root.request-filter-changed(); }
                    }
                    warning-check := LabelledCheck {
                        label: "warning";
                        value <=> root.show-warning;
                        toggled(v) => { root.request-filter-changed(); }
                    }
                    info-check := LabelledCheck {
                        label: "info";
                        value <=> root.show-info;
                        toggled(v) => { root.request-filter-changed(); }
                    }
                    Rectangle { }
                }
                Rectangle {
                    height: root.findings-summary == "" ? 0px : 28px;
                    border-radius: Tokens.radius-subtle;
                    background: root.filter-hides-rows ? Tokens.caution-surface : transparent;
                    Text {
                        x: Tokens.space-3;
                        width: parent.width - 2 * Tokens.space-3;
                        text: root.findings-summary;
                        vertical-alignment: center;
                        overflow: elide;
                        font-weight: root.filter-hides-rows ? Tokens.weight-bold
                            : Tokens.weight-regular;
                        color: root.filter-hides-rows ? Tokens.caution : Tokens.body;
                    }
                }
            }
        }

        // Findings and detail sit side by side when there is room for both and stack when there is
        // not, so choosing a row never scrolls the list out of view on a wide window. The geometry
        // is set here rather than by a layout because Slint cannot switch a layout's direction
        // without the markup appearing in both branches.
        Rectangle {
            property <length> inner: root.column-width - 2 * Tokens.space-5;
            property <length> gap: Tokens.space-4;
            property <length> left: (self.inner - self.gap) * root.findings-share / 100;
            height: root.side-by-side
                ? max(findings-card.preferred-height, detail-card.preferred-height)
                : findings-card.preferred-height + self.gap + detail-card.preferred-height;

            findings-card := Card {
                title: "FINDINGS";
                x: 0;
                y: 0;
                width: root.side-by-side ? parent.left : parent.inner;
                height: root.side-by-side ? parent.height : self.preferred-height;
                VerticalLayout {
                    spacing: Tokens.space-1;
                    alignment: start;
                    HorizontalLayout {
                        // The row's own padding, both sides, so the headings sit over the values.
                        padding-left: Tokens.space-1;
                        padding-right: Tokens.space-1;
                        spacing: Tokens.space-2;
                        height: Tokens.space-5;
                        ColumnHead { text: "TARGET"; width: Tokens.col-target; }
                        ColumnHead { text: "KIND"; width: Tokens.col-kind; }
                        ColumnHead { text: "OBJECT"; }
                        ColumnHead { text: "STATUS"; width: Tokens.col-status; }
                        ColumnHead { text: "SEVERITY"; width: Tokens.col-pill; }
                    }
                    for row[i] in root.findings: FindingLine {
                        background: mod(i, 2) == 0 ? transparent : Tokens.stripe;
                        data: row;
                        clicked => { root.choose-row(i); }
                    }
                }
            }

            detail-card := Card {
                title: "DETAIL";
                x: root.side-by-side ? parent.left + parent.gap : 0;
                y: root.side-by-side ? 0 : findings-card.preferred-height + parent.gap;
                width: root.side-by-side
                    ? (parent.inner - parent.gap) * root.detail-share / 100
                    : parent.inner;
                height: root.side-by-side ? parent.height : self.preferred-height;
                VerticalLayout {
                    spacing: Tokens.space-2;
                    alignment: start;
                    heading-text := Text {
                        text: root.selected-heading == "" ? "Select a finding to see its detail."
                            : root.selected-heading;
                        font-family: Tokens.family-display;
                        font-size: Tokens.text-control;
                        font-weight: Tokens.weight-bold;
                        letter-spacing: Tokens.tracking-tight;
                        color: root.selected-heading == "" ? Tokens.muted : Tokens.heading;
                        overflow: elide;
                    }
                    if root.selected-deltas.length > 0: HorizontalLayout {
                        spacing: Tokens.space-2;
                        height: Tokens.space-5;
                        ColumnHead { text: "ATTRIBUTE"; width: root.delta-attribute-width; }
                        ColumnHead { text: "MASTER"; width: root.delta-column-width; }
                        ColumnHead { text: "TARGET"; width: root.delta-column-width; }
                        ColumnHead { text: ""; }
                    }
                    for d in root.selected-deltas: HorizontalLayout {
                        spacing: Tokens.space-2;
                        Text {
                            text: d.attribute;
                            width: root.delta-attribute-width;
                            overflow: elide;
                            font-family: Tokens.family-mono;
                            color: Tokens.heading;
                        }
                        Text {
                            text: d.is_body ? "(see diff below)" : d.master;
                            width: root.delta-column-width;
                            overflow: elide;
                            font-family: d.is_body ? Tokens.family-body : Tokens.family-mono;
                            color: d.is_body ? Tokens.muted : Tokens.body;
                        }
                        Text {
                            text: d.is_body ? "" : d.target;
                            width: root.delta-column-width;
                            overflow: elide;
                            font-family: Tokens.family-mono;
                            color: Tokens.body;
                        }
                        Text {
                            text: d.severity;
                            width: root.delta-severity-width;
                            overflow: elide;
                            color: d.severity == "error" ? Tokens.danger
                                : d.severity == "warning" ? Tokens.caution : Tokens.muted;
                        }
                        Text {
                            text: d.note;
                            width: root.delta-column-width;
                            overflow: elide;
                            color: Tokens.muted;
                        }
                    }
                    // Horizontal scrolling: a routine body is one line and may be tens of KB,
                    // which must scroll rather than wrap or size the window.
                    diff-scroll := ScrollView {
                        height: root.selected-diff.length == 0 ? 0px : 280px;
                        VerticalLayout {
                            alignment: start;
                            for line[i] in root.selected-diff: VerticalLayout {
                                if root.starts-group(i): Text {
                                    text: line.attribute;
                                    font-family: Tokens.family-mono;
                                    font-weight: Tokens.weight-bold;
                                    color: Tokens.heading;
                                }
                                Rectangle {
                                    border-radius: Tokens.radius-subtle;
                                    background: line.kind == "added" || line.kind == "removed"
                                        ? root.diff-colour(line.kind).with-alpha(0.12) : transparent;
                                    // A layout, not a bare child: Slint centres a child that sets no
                                    // x, which put a short line in the middle of its bar, and a child
                                    // placed by hand gives the bar no height.
                                    HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: line.text;
                                            font-family: Tokens.family-mono;
                                            wrap: no-wrap;
                                            color: root.diff-colour(line.kind);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Card {
            title: "REPORTS";
            HorizontalLayout {
                spacing: Tokens.space-2;
                output-edit := LineEdit {
                    text <=> root.output-directory;
                    placeholder-text: "output directory";
                    max-width: Tokens.field-max;
                    // The two-way binding keeps the window property in step; this says so out
                    // loud, so the value reaches the configuration and is saved with it.
                    edited(v) => { root.output-directory-changed(v); }
                }
                Button { text: "Choose…"; clicked => { root.request-choose-output-directory(); } }
                Button {
                    text: "Write reports";
                    enabled: root.reports-enabled;
                    clicked => { root.request-write-reports(); }
                }
                Button {
                    text: "Open HTML report";
                    enabled: root.reports-enabled;
                    clicked => { root.request-open-html(); }
                }
                Rectangle { }
            }
        }
    }
}
