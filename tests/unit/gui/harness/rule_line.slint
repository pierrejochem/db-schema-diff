// Test-only windows around components that are not windows themselves, so Python can instantiate
// them. They add nothing: each forwards one row in and reads two properties back out.

import { RuleLine, RuleRow } from "../../../../src/db_schema_diff/gui/ui/ignores_tab.slint";

export { RuleRow }

export component RuleLineHarness inherits Window {
    in property <RuleRow> data;
    out property <int> editable-count: line.editable-count;
    out property <[string]> action-choices: line.action-choices;
    line := RuleLine { data: root.data; }
}
